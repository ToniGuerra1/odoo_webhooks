<!-- views/webhook_log_views.xml -->
<odoo>
    <record id="view_webhook_log_tree" model="ir.ui.view">
        <field name="name">webhook.log.tree</field>
        <field name="model">webhook.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="success"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_webhook_log_form" model="ir.ui.view">
        <field name="name">webhook.log.form</field>
        <field name="model">webhook.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="endpoint"/>
                        <field name="status_code"/>
                        <field name="success"/>
                        <field name="error_message"/>
                        <field name="create_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="json_data" widget="text"/>
                        <field name="response_text" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_webhook_log" model="ir.actions.act_window">
        <field name="name">Registros de Webhooks</field>
        <field name="res_model">webhook.log</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- Menú opcional para acceder desde el módulo -->
    <menuitem id="menu_webhook_log_root"
              name="Webhook Logs"
              parent="menu_webhook_root"
              action="action_webhook_log"
              groups="base.group_system"
              sequence="14"/>


</odoo>

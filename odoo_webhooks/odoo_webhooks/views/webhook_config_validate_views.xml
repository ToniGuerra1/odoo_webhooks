<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_webhook_validate_form" model="ir.ui.view">
        <field name="name">webhook.validate.form</field>
        <field name="model">webhook.config.validate</field>
        <field name="arch" type="xml">
            <form string="Validación de Licencia">
                <sheet>
                    <group>
                        <field name="license_key"/>
                        <field name="email"/>
                        <button name="action_check_license" type="object" string="Validar Licencia" class="oe_highlight"/>
                        <field name="license_status" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webhook_validate" model="ir.actions.act_window">
        <field name="name">Validación de Licencia</field>
        <field name="res_model">webhook.config.validate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_webhook_validate" name="Validación de Licencia"
              parent="menu_webhook_root" action="action_webhook_validate" sequence="14" groups="base.group_system"/>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_partner_form_inherit_webhook" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.webhook</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Webhooks">
                    <group>
                        <field name="webhook_config_id"/>
                        <button name="action_send_webhook_from_partner"
                                type="object"
                                string="Enviar Webhook"
                                class="oe_highlight"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_webhook" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.webhook</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insertar una nueva página "Webhooks" en la parte de Tabs (notebook) -->
            <xpath expr="//notebook" position="inside">
                <page string="Webhooks">
                    <group>
                        <field name="webhook_config_id"/>
                        <button name="action_send_webhook_from_sale"
                                type="object"
                                string="Enviar Webhook"
                                class="oe_highlight"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
